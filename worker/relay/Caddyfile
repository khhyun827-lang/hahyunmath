# 알리고 고정 IP 중계 (2026-09-21)
#
# 왜 — 알리고는 «등록된 발신 IP» 만 받는데 Cloudflare 워커는 IP 가 고정이 아니다(데이터센터마다 풀이 다르다).
#      그래서 고정 IP 가 있는 이 서버가 대신 알리고를 부른다. 알리고엔 이 서버 IP 하나만 등록한다.
# 무엇 — 워커가 X-Relay-Key 열쇠를 달고 보내면, 열쇠를 확인하고 몸통을 그대로 알리고로 넘긴다.
#        /sms/*   → https://apis.aligo.in/*        (문자·MMS · 리포트)
#        /kakao/* → https://kakaoapi.aligo.in/*    (알림톡)
# 채울 것 둘 — RELAY_HOST_HERE (예 1.2.3.4.sslip.io · 점을 그대로 둔 IP 뒤에 .sslip.io) · RELAY_KEY_HERE (긴 무작위 글자)
#   RELAY_KEY_HERE 와 같은 값을 Cloudflare Secret ALIGO_RELAY_KEY 에, https://RELAY_HOST_HERE 를 ALIGO_RELAY 에 넣는다.
# ⚠ handle 블록은 «적은 차례»로 본다 — 열쇠 검사가 맨 위여야 한다. 아래로 내리면 열쇠 없이도 넘어간다.

RELAY_HOST_HERE {
	@nokey not header X-Relay-Key "RELAY_KEY_HERE"
	handle @nokey {
		respond "no" 403
	}
	handle_path /sms/* {
		reverse_proxy https://apis.aligo.in {
			header_up Host {upstream_hostport}
		}
	}
	handle_path /kakao/* {
		reverse_proxy https://kakaoapi.aligo.in {
			header_up Host {upstream_hostport}
		}
	}
	handle {
		respond "relay ok" 200
	}
}
