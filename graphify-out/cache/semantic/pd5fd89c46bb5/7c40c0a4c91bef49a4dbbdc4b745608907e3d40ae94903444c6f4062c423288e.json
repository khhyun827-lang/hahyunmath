 \uc644\uc131\ub3c4\ubcf4\ub2e4 \uc55e\uc120\ub2e4."}, {"id": "design_v1_00_system_role_first", "label": "\ud654\uba74\uc758 \uc5ed\ud560 \uba3c\uc800 \uc815\uc758", "file_type": "rationale", "source_file": "design-v1/00-system.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uac01 \ud654\uba74\uc774 \ubb34\uc5c7\uc744 \ud558\ub294 \uc790\ub9ac\uc778\uc9c0 \ud55c \ubb38\uc7a5\uc73c\ub85c \uc815\ud55c \ub4a4 UX\ub97c \uace0\ub978\ub2e4. \uc21c\uc11c\uac00 \ub4a4\ubc14\ub00c\uba74 \uae30\ub2a5\uc774 \ub9ce\uc740 \ud654\uba74\uc774 \ub418\uace0 \uc81c\ud488\uc774 \uc544\ub2c8\uac8c \ub41c\ub2e4."}, {"id": "design_v1_00_system_single_door", "label": "\uac19\uc740 \uacf3\uc73c\ub85c \uac00\ub294 \ubb38\uc740 \ud558\ub098", "file_type": "rationale", "source_file": "design-v1/00-system.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc2e0\ud638 \uc804\uc6a9 \ud654\uba74(05)\uc774 \uc0dd\uacbc\uc73c\ubbc0\ub85c \uba85\ub2e8\uc758 \u300c\uc704\ud5d8 \uc2e0\ud638\u300d \uc800\uc7a5\ub41c \ubdf0\ub294 \uc5c6\uc574\ub2e4. \ubb38\uc774 \ub458\uc774\uba74 \uc5b4\ub290 \ucabd\uc774 \ucd5c\uc2e0\uc778\uc9c0 \ub9e4\ubc88 \ud5f7\uac08\ub9b0\ub2e4."}, {"id": "design_v1_00_system_discarded", "label": "\ubb34\uc5c7\uc744 \ubc84\ub838\ub294\uac00", "file_type": "rationale", "source_file": "design-v1/00-system.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A4 \ub2e4\ud06c \ud14c\ub9c8(\ucc98\ub9ac\ud568\ub9cc \uac80\uc73c\uba74 \uac19\uc740 \uc81c\ud488\uc774 \uc544\ub2d8) \u00b7 A1 \ud30c\ub791 \uc120\ud0dd\uc0c9 #1F6FEB(\uc120\ud0dd\uc0c9\uc740 \ud558\ub098) \u00b7 A1 IBM Plex Sans KR(\ubcf8\ubb38\uc740 Pretendard \ud558\ub098, \ud45c \ud3ed \ubb38\uc81c\ub294 tabular-nums\ub85c) \u00b7 A5 3\uc5f4 \uce78\ubc18(\uce74\ub4dc 27\uc7a5\uc774 \ud769\uc5b4\uc9c0\uba7