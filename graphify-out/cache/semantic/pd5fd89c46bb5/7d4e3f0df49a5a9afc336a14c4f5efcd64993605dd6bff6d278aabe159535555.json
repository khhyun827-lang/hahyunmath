tion": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ub9e4\uc77c \uacb0\uacfc\uac00 \ub2ec\ub77c A\ubcf4\ub2e4 \uc624\ub798 \uac04\ub2e4. \uc6b4\uc774 \uc804\ubd80\ub77c \uc2e4\ub9dd\ud558\ub294 \ub0a0\uc774 \uc0dd\uae30\uace0, \uc2a4\ud2f0\ucee4 \uc5ec\uc12f\uc740 \uc790\ub9ac\ud45c\uc2dc\ub77c \uc120\uc0dd\ub2d8\uc774 \uc815\ud574\uc57c \ud55c\ub2e4."}, {"id": "design_v1_21_checkin_c", "label": "\uc2dc\uc548 C \u00b7 \uc624\ub298\uc758 \ud55c \ubb38\uc81c (C, drawC, hitC)", "file_type": "code", "source_file": "design-v1/21-checkin.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ud2c0\ub824\ub3c4 \ub3c4\uc7a5\uc740 \ucc0d\ud78c\ub2e4 \u2014 \uc628 \uac83\uc744 \ubc8c\ud558\uc9c0 \uc54a\ub294\ub2e4. \uc218\ud559 \ud559\uc6d0\ub2e4\uc6b4 \uc720\uc77c\ud55c \uc548. \ub300\uc2e0 \uac00\uc7a5 \ubb34\uac81\uace0 \ub370\uc77c\ub9ac\ud034\uc988\uc640 \ubb38\uc81c\uac00 \ub458\uc774 \ub41c\ub2e4."}, {"id": "design_v1_21_checkin_game", "label": "Game \u2014 \uce94\ubc84\uc2a4 \uac8c\uc784 \uc178 (mount/stop/_loop/_step/_draw/_player/_star/_end)", "file_type": "code", "source_file": "design-v1/21-checkin.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uce94\ubc84\uc2a4 \ud558\ub098\u00b7\ub8e8\ud504 \ud558\ub098\u00b7\uc785\ub825 \ud55c \ubc8c. D\uc758 \u00ab\uc808\ubc18\u00bb\uc774\uace0 \ub7ec\ub108\ub85c \uac00\ub354\ub77c\ub3c4 \uadf8\ub300\ub85c \uc4f4\ub2e4. \uac8c\uc784\uc774 \ubc14\ub00c\uba74 _step\uacfc _draw\ub9cc \uac08\uc544 \ub07c\uc6b4\ub2e4."}, {"id": "design_v1_21_checkin_d", "label": "\uc2dc\uc548 D \u00b7 \ub625\ud53c\ud558\uae30 (D, drawD, openGame, startGame, closeGame, endGame)", "file_type": "code", "source_file": "design-v1/21-checkin.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc9c4\uc9dc \uac8c\uc784. \ud558\ub8e8 \ud55c \ud310, \ub05d\ub098\uba74 \ub3c4\uc7a5\uc774 \ucc0d\ud788\uace0 \ub0b4\uc77c\uae4c\uc9c0 \ub2eb\ud78c\ub2e4. \uc5f4\uc5c8\ub2e4\uac00 \uc2dc\uc791 \uc804\uc5d0 \ub2eb\uc740 \uac83\uc740 \uc18c\ubaa8\ub418\uc9c0 \uc54a\ub294\ub2e4."}, {"id": "design_v1_21_checkin_rank", "label": "RANK \u00b7 rankPut \u00b7 rankHTML \u2014 \uc774\ubc88 \uc8fc \uc21c\uc704", "file_type": "code", "source_file": "design-v1/21-checkin.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ud559\uc6d0 \uc804\uccb4 \u00b7 \uc8fc\ub9c8\ub2e4 \uc0c8\ub85c \u00b7 \uc0c1\uc704 5\uba85 \u00b7 \uc774\ub984 \uc606\uc5d0 \ubc18. \uadf8 \uc8fc\uc758 \ucd5c\uace0\ub9cc \ub0a8\uae34\ub2e4."}, {"id": "design_v1_21_checkin_resetd", "label": "resetD() / setStyle() \u2014 \uc2dc\uc548 \uc804\uc6a9 \uc2a4\uc704\uce58", "file_type": "code", "source_file": "design-v1/21-checkin.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc2e4\uc11c\ube44\uc2a4\uc5d0\ub294 \uc5c6\ub2e4. \ud558\ub8e8 \ud55c \ud310\uc774\ub77c \uc774\uac8c \uc5c6\uc73c\uba74 \uc2dc\uc548\uc744 \ud55c \ubc88\ubc16\uc5d0 \ubabb \ub20c\ub7ec \ubcf8\ub2e4."}, {"id": "design_v1_21_checkin_not_attendance", "label": "\ub3c4\uc7a5\uc740 \ucd9c\uacb0\uc774 \uc544\ub2c8\ub2e4", "file_type": "rationale", "source_file": "design-v1/21-checkin.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uac15\uc0ac\uc758 \ucd9c\uc11d\u00b7\uc9c0\uac01\u00b7\uc870\ud1f4\u00b7\uacb0\uc11d\uacfc \uc644\uc804\ud788 \ub2e4\ub978 \uc904\uc5d0 \uc313\uc774\uba70 \ucd9c\uc11d\ub960\uc5d0 \ud55c \uc22b\uc790\ub3c4 \uc11e\uc774\uc9c0 \uc54a\ub294\ub2e4. \uadf8\ub798\uc11c \u300c\ucd9c\uc11d \uccb4\ud06c\u300d\uac00 \uc544\ub2c8\ub77c \u300c\ucd9c\uc11d \ub3c4\uc7a5\u300d. \uc5f0\uc18d\uc740 \uc218\uc5c5 \uc5c6\ub294 \ub0a0\ub3c4 \uc13c\ub2e4. \uac15\uc0ac \ud654\uba74\uc5d4 \uc548 \ubd99\uc778\ub2e4(\uc9c0\ud45c\uac00 \ub418\uba74 \uac00\ubcbc\uc6b4 \uac83\uc774 \uc544\ub2c8\uac8c \ub428). \ubcf4\uc0c1 \uc5c6\uc74c."}, {"id": "design_v1_21_checkin_save_on_press", "label": "\uc800\uc7a5\uc740 \u00ab\ub20c\ub800\uc744 \ub54c\u00bb\ub9cc", "file_type": "rationale", "source_file": "design-v1/21-checkin.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc774 \uc571\uc740 \ud559\uc0dd \ud654\uba74\uc744 \uadf8\ub9ac\uae30\ub9cc \ud574\ub3c4 \uc800\uc7a5\ud55c\ub2e4(\ub370\uc77c\ub9ac\ud034\uc988\uac00 \uc624\ub298 \ubf51\uae30\ub97c \ubc15\uc544 \ub450\ubbc0\ub85c). \ub3c4\uc7a5\uc740 \uadf8 \uae38\uc744 \ub530\ub77c\uac00\uc9c0 \uc54a\ub294\ub2e4. \u300c\uc5f0 \uac83\u300d\uacfc \u300c\ucc0d\uc740 \uac83\u300d\uc774 \uac19\uc544\uc9c0\uba74 \ub3c4\uc7a5\uc774 \uc544\ubb34 \ub73b\ub3c4 \uc5c6\ub2e4. D\ub294 \ud310\uc774 \ub05d\ub0a0 \ub54c \ud55c \ubc88\ub9cc \uc800\uc7a5 \u2014 \ub8e8\ud504 \uc548\uc5d0\uc11c \uc800\uc7a5\ud558\uba74 \ucd08\ub2f9 60\ubc88."}, {"id": "design_v1_21_checkin_rec_checkin", "label": "rec.checkin \ub370\uc774\ud130 \ubaa8\uc591 (last/streak/best/days/bestScore)", "file_type": "concept", "source_file": "design-v1/21-checkin.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uae30\uc874 \uac08\ub798\ub294 \ud55c \uae00\uc790\ub3c4 \uc548 \uac74\ub4dc\ub9ac\uace0 \uc904 \ud558\ub098\ub97c \ub354\ud55c\ub2e4. \uc14b\uc740 days\uc758 \ubaa8\uc591\ub9cc \ub2e4\ub974\uace0 last\u00b7streak\u00b7best\ub294 \uacf5\ud1b5\uc774\ub77c \ub098\uc911\uc5d0 A\u2192B\ub85c \uac08\uc544\ub3c4 \uc5f0\uc18d \uc77c\uc218\uac00 \uc774\uc5b4\uc9c4\ub2e4. \ub0a0\uc9dc\ub294 todayStr()(\ub85c\uceec) \u2014 UTC\uba74 \ud55c\uad6d \uc0c8\ubcbd\uc5d0 \ud558\ub8e8\uac00 \uc5b4\uae0b\ub09c\ub2e4."}, {"id": "design_v1_21_checkin_rank_doc", "label": "rank:<\uadf8 \uc8fc \uc6d4\uc694\uc77c> \ubcc4\ub3c4 \ubb38\uc11c", "file_type": "concept", "source_file": "design-v1/21-checkin.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "record:\ud559\ubc88\uc5d0\ub294 \uc131\uc801\u00b7\ucd9c\uacb0\uc774 \ub2e4 \ub4e4\uc5b4 \uc788\uc5b4 \uc21c\uc704\ub97c \uadf8\ub9ac\uc790\uace0 \ub0a8\uc758 \uae30\ub85d\uc744 \uc77d\uc73c\uba74 \uc548 \ub41c\ub2e4. \uc774\ub984\u00b7\ubc18\u00b7\uc810\uc218\ub9cc \ub4e0 \ubcc4\ub3c4 \ubb38\uc11c. \uc5f4\uc1e0\uc5d0 \uc8fc\uac00 \ub4e4\uc5b4 \uc788\uc5b4 \u00ab\ub9ac\uc14b\u00bb \ub3d9\uc791\uc774 \uc5c6\ub2e4. \uc4f8 \ub54c\ub294 \uc77d\uace0 \u2192 \ub0b4 \uc904\ub9cc \uace0\uce58\uace0 \u2192 \uc4f4\ub2e4. \ube0c\ub77c\uc6b0\uc800\uac00 Firestore\ub97c \uc9c1\uc811 \ubd80\ub974\ubbc0\ub85c \uc870\uc791\uc740 \ubabb \ub9c9\ub294\ub2e4 \u2014 \uc0c1\ud488\uc744 \uac78\uba74 \uc6cc\ucee4 \uac80\uc99d \ud544\uc218."}, {"id": "design_v1_21_checkin_no_rank_below_5", "label": "5\uc704 \ubc16\uc774\uba74 \ub4f1\uc218\ub97c \ub9d0\ud558\uc9c0 \uc54a\ub294\ub2e4", "file_type": "rationale", "source_file": "design-v1/21-checkin.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ub9e4\uc77c \uc790\uae30 \uc774\ub984\uc774 \uaf34\ucc0c\uc778 \uac83\uc744 \ubcf4\uba74 \uadf8\ub9cc\ub454\ub2e4. \ub300\uc2e0 \u300c\uc774\ubc88 \uc8fc \ub0b4 \ucd5c\uace0 N\uc810\u300d\ub9cc. \uc804\uccb4\ub85c \ud569\uce58\uba74 5\uc704\uac00 \uba40\uc5b4\uc838 \uc774 \uc904\uc774 \ub354 \uc911\uc694\ud574\uc9c4\ub2e4. 1\uc704\ub9cc \ube0c\ub79c\ub4dc\uc0c9."}, {"id": "design_v1_21_checkin_difficulty", "label": "\ub09c\uc774\ub3c4 \uc138 \ucd95 (\ub099\ud558 \uc18d\ub3c4 \u00b7 \uc0dd\uc131 \uac04\uaca9 \u00b7 \ud55c \ubc88\uc5d0 \ub5a8\uc5b4\uc9c0\ub294 \uac1c\uc218)", "file_type": "rationale", "source_file": "design-v1/21-checkin.html", "source_lo