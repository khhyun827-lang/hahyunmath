{"nodes": [{"id": "tools_cut_sprite_tool", "label": "cut-sprite (\uc2a4\ud504\ub77c\uc774\ud2b8 \ub530\ub0b4\uae30 \ub3c4\uad6c)", "file_type": "code", "source_file": "tools/cut-sprite.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tools_cut_sprite_two_pass_flood_fill", "label": "\ub450 \ubc88 \ub098\ub208 flood fill (\uc5b4\ub450\uc6b4 \ubc30\uacbd \u2192 \ubc1d\uc740 \ubb34\ucc44\uc0c9 \ubc1c\uad11)", "file_type": "concept", "source_file": "tools/cut-sprite.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uac80\uc740 \ubc30\uacbd \uc704 \ud770 \ubc1c\uad11 \ud14c\ub450\ub9ac\uac00 \uc788\ub294 \uadf8\ub9bc\uc5d0\uc11c \uc778\ubb3c\ub9cc \ub0a8\uae34\ub2e4. \ucd95\uc18c\ud55c \ub4a4 \ud6d1\uc73c\uba74 \uc724\uacfd\uc120(20)\uacfc \ubc1c\uad11(240)\uc774 \uc11e\uc5ec \uc911\uac04 \ud68c\uc0c9\uc774 \ub418\uc5b4 \uc724\uacfd\uc120\uc744 \ub6ab\ub294 \ub2e4\ub9ac\uac00 \ub418\ubbc0\ub85c \uc6d0\ubcf8 \ud574\uc0c1\ub3c4\ub85c \ud6d1\ub294\ub2e4. \uc2e4\uce21\ud558\ub2c8 \ubc30\uacbd\uc740 \uc815\ud655\ud788 0\uc774\uace0 \ud55c\ub450 \ud53d\uc140 \ub9cc\uc5d0 \uc724\uacfd\uc120(L\u224827~36)\uc774 \uc640\uc11c \ubb38\ud131 DARK=16, \ubc1c\uad11 \ub2e8\uacc4\ub294 \uaebc \ub454\ub2e4(\ud770 \uc2e0\ubc1c L=254\uae4c\uc9c0 \uba39\uc744 \uc704\ud5d8)."}, {"id": "tools_cut_sprite_white_mode_saturation", "label": "white \uac08\ub798 \u2014 \ucc44\ub3c4\ub85c \uc9c0\uc6b4\ub2e4 (\uc5f0\uacb0 \uc548 \uc500)", "file_type": "concept", "source_file": "tools/cut-sprite.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ub3c4\uc7a5\uc740 \ub2eb\ud78c \uc6d0\uc774\ub77c \uc548\ucabd \ud770\uc0c9\uc774 \ubc14\uae65\uacfc \uc774\uc5b4\uc838 \uc788\uc9c0 \uc54a\uc544 flood fill\uc774\uba74 \ud770 \uc6d0\ubc18\uc774 \ub0a8\ub294\ub2e4. \ubc1d\uae30\ub9cc\uc73c\ub85c \uac00\ub974\uba74 \uc605\uc740 \ubcf4\ub77c \ucc44\uc6c0(\ubc1d\uae30 212)\uae4c\uc9c0 \ub0a0\uc544\uac00\ubbc0\ub85c \ucc44\ub3c4\uac00 \uae30\uc900. JPEG \uc7a1\ud2f0\uac00 \uc54c\ud30c 5~20 \uc548\uac1c\ub85c \uae54\ub824 \uc678\ub534 \uc810\uc774 \ubcf8\uccb4\uc640 \uc774\uc5b4\uc9c0\ubbc0\ub85c a<0.10\uc740 0\uc73c\ub85c \uc790\ub978\ub2e4."}, {"id": "tools_cut_sprite_clip_main", "label": "clip=main \u2014 \uc0c1\uc790\uac00 \uac00\uc7a5 \ud070 \uc870\uac01 \ubc16\uc744 \uc9c0\uc6b4\ub2e4", "file_type": "concept", "source_file": "tools/cut-sprite.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u300c\ucc38!\u300d \ub290\ub08c\ud45c\ub294 \uc5bc\ub8e9\uacfc \ud06c\uae30\uac00 \ube44\uc2b7\ud574 \ud06c\uae30\ub85c\ub294 \ubabb \uac00\ub974\uace0 \uc790\ub9ac(\uc6d0 \uc548/\ubc16)\ub85c \uac00\ub978\ub2e4. \uac00\uc7a5 \ud070 \uc870\uac01\uc744 \ud53d\uc140 \uc218\ub85c \uace0\ub974\uba74 \uc587\uc740 \ud14c\ub450\ub9ac \ub300\uc2e0 \uc548\ucabd \ub369\uc5b4\ub9ac\uac00 \ubf51\ud600 \ud14c\ub450\ub9ac\uac00 \uc798\ub824 \ub098\uac00\ubbc0\ub85c \uc0c1\uc790 \uba74\uc801\uc73c\ub85c \uace0\ub978\ub2e4. \uce90\ub9ad\ud130\uc5d0\ub294 \uc4f0\uba74 \uc548 \ub41c\ub2e4(\uba3c\uc9c0\u00b7\uc18d\ub3c4\uc120\uc774 \ubab8\ud1b5 \uc0c1\uc790 \ubc16). \uae30\uc900\uc810\uc740 \uc0c9 \uc788\ub294 \ud53d\uc140\uc758 \ubb34\uac8c\uc911\uc2ec \u2014 \ubb34\ucc44\uc0c9 \uba3c\uc9c0\u00b7\uc18d\ub3c4\uc120\uc774 \uc800\uc808\ub85c \ube60\uc9c4\ub2e4."}, {"id": "game_char_sprite", "label": "game-char.webp (\ub530\ub0b8 \uce90\ub9ad\ud130 \uc2a4\ud504\ub77c\uc774\ud2b8)", "file_type": "image", "source_file": "tools/cut-sprite.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "tools_cut_sprite_tool", "target": "game_char_sprite", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "tools/