{"nodes": [{"id": "project2_worknote", "label": "\ud504\ub85c\uc81d\ud2b82 \uc791\uc5c5\ub178\ud2b8 \u2014 4\uad8c \uc555\ucd95 \uad50\uc7ac", "file_type": "document", "source_file": "project2/\uc791\uc5c5\ub178\ud2b8.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project2_worknote_judgment_criterion", "label": "\ud310\uc815 \uae30\uc900 \u2014 \uc555\ucd95\ubcf8\ub9cc \uc775\ud788\uba74 4\uad8c \uc804\ubd80 \ud480 \uc218 \uc788\uc5b4\uc57c \ud55c\ub2e4", "file_type": "rationale", "source_file": "project2/\uc791\uc5c5\ub178\ud2b8.md", "source_location": "\u00a70-A", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ubaa9\uc801\uc740 \uc555\ucd95\uc774 \uc544\ub2c8\ub2e4. \ubb3c\uc74c\uc744 \u00ab\ub2ee\uc558\ub294\uac00\u00bb\uc5d0\uc11c \u00ab\ub300\ud45c\ub97c \uc775\ud78c \ud559\uc0dd\uc774 \uc774\uac83\uc744 \ud480\uc5b4\ub0bc \uc218 \uc788\ub294\uac00\u00bb\ub85c \ub4a4\uc9d1\uc5c8\ub2e4. \uae30\ubcf8\uac12\uc740 \ub0a8\uae30\uae30\uc774\uba70 \uc9c0\uc6b0\ub824\uba74 \u00ab\uc644\uc804\ud788 \ub2f4\uae34\ub2e4\u00bb\ub97c \ubb38\uc7a5\uc73c\ub85c \ubcf4\uc5ec\uc57c \ud55c\ub2e4. \uadfc\uac70\ub294 \uc720\ud615 \ud0dc\uadf8\u00b7\ub09c\uc774\ub3c4\uac00 \uc544\ub2c8\ub77c \ubc1c\uc0c1\u00b7\uc870\uac74 \ud574\uc11d. 2026-08-16 \uc774\uc804 \uc61b \uae30\uc900\uc740 \uacfc\uc555\ucd95(\uc9d1\ud569 470\u2192120, \ub3c4\ud615\uc758 \uc774\ub3d9 234\u219289)\uc744 \ub0b3\uc558\ub2e4."}, {"id": "project2_worknote_difficulty_not_for_judgment", "label": "\ub09c\uc774\ub3c4 \uc810\uc218\ub97c \ud310\uc815\uc5d0 \uc4f0\uc9c0 \uc54a\ub294\ub2e4", "file_type": "rationale", "source_file": "project2/\uc791\uc5c5\ub178\ud2b8.md", "source_location": "\u00a70-A", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ud574\uc124 \uae38\uc774\u00b7\uacbd\uc6b0 \ub098\ub204\uae30 \ud69f\uc218\ub85c \uc7ac\ub294 \ub300\ub9ac \uc9c0\ud45c\ub77c \uc11c\uc220\ud615\uc740 \ubd80\ud480\uace0 \ud654\uc0b4\ud45c\ub85c \uc801\uc740 \uac83\uc740 \ub20c\ub9b0\ub2e4. \uc0ad\uc81c \ud310\uc815\u00b7SCENE \ubc30\uce58\u00b7SCENE3 \ucc28\ub840\uc5d0 \uc4f0\uc9c0 \uc54a\uace0 DB\uc5d0 \uc2e3\uae30\ub9cc \ud55c\ub2e4. \ub2e4\ub9cc \uc9c0\uc6b4 \ucabd\uc774 \ub09c\uc774\ub3c4 8~9\uc778\ub370 \ub300\ud45c\uac00 3~6\uc774\uba74 \u00ab\ub3d9\uc77c\u00bb \uc0ac\uc720\uac00 \ud2c0\ub838\ub2e4\ub294 \uacbd\uace0 \uc2e0\ud638\ub85c\ub294 \uc4f4\ub2e4."}, {"id": "project2_worknote_representative_id_rule", "label": "\uc9c0\uc6b4 \uc0ac\uc720\uc5d0 \ub300\ud45c \ubb38\ud56d ID \ud544\uc218", "file_type": "rationale", "source_file": "project2/\uc791\uc5c5\ub178\ud2b8.md", "source_location": "\u00a70-A, \u00a72-B", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\u300c\ub3d9\uc77c\u300d\u00b7\u300cT08\uc774 \ub2f4\ub2f9\u300d\ucc98\ub7fc\ub9cc \uc4f0\uba74 \uac80\uc99d\uc774 \uc548 \ub41c\ub2e4. \uc720\ud615 \uc774\ub984\uc73c\ub85c \ubbf8\ub8e8\uba74 A-083\ucc98\ub7fc \uc2e4\uc81c \ub2f4\ub2f9(C-064, T09)\uacfc \uc5b4\uae0b\ub09c\ub2e4. \ub300\ud45c\uac00 \ub2e4\ub978 \ud68c\ucc28\uc5d0\uc11c \uc9c0\uc6cc\uc9c0\uba74 \ud559\uc2b5 \uc694\uc18c\uac00 \ud1b5\uc9f8\ub85c \uc0ac\ub77c\uc9c0\ubbc0\ub85c \ud310\uc815 \ud6c4 \uccb4\uc778\uc744 \uae30\uacc4\ub85c \uc804\uc218 \ud655\uc778\ud55c\ub2e4."}, {"id": "project2_worknote_chain_break", "label": "\uccb4\uc778 \ub04a\uae40 \u2014 \ub300\ud45c\uac00 \ub098\uc911 \ud68c\ucc28\uc5d0\uc11c \uc9c0\uc6cc\uc9d0", "file_type": "concept", "source_file": "project2/\uc791\uc5c5\ub178\ud2b8.md", "source_location": "\u00a72-B", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\ud68c\ucc28(\uc720\ud615)\ubcc4\ub85c \ub098\ub220 \ud310\uc815\ud558\uba74 \ubc18\ub4dc\uc2dc \uc0dd\uae34\ub2e4. \ub3c4\ud615\uc758 \uc774\ub3d9 3\uac74(D-016\u2192B-011\u2192\uc0ad\uc81c\ub428), \uc9d1\ud569 10\uac74. \ub04a\uae30\ub294 \ubc29\uc2dd\uc740 \ub458: \ub300\ud45c ID \ubbf8\uae30\uc7ac(8\uac74), \ub300\ud45c\uac00 \uc9c0\uc6cc\uc9d0(C-092\u2192C-091\u2192\uc0ad\uc81c\ub428)."}, {"id": "project2_worknote_scene_placement", "label": "SCENE \ubc30\uce58 \u2014 \ubc1c\uc0c1\uc758 \uce35", "file_type": "rationale", "source_file": "project2/\uc791\uc5c5\ub178\ud2b8.md", "source_location": "\u00a70-A", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "SCENE1 \uae30\ubcf8\uc720\ud615\uc740 \uaddc\uce59\uc744 \ud55c \ubc88 \uc801\uc6a9, \uc720\ud615\ub9c8\ub2e4 \ucd5c\uc18c \ud615\ud0dc \ud558\ub098(\ube48 \uc720\ud615 \uae08\uc9c0). SCENE2 \ubc1c\uc804\uc720\ud615\uc740 \uc870\uac74\uc774 \ud55c \uacb9 \uc5b9\ud788\ub418 \ub3c4\uad6c\ub294 SCENE1 \uac83. SCENE3 \uc2e4\uc804\uc740 \u00ab\uc5b4\ub824\uc6b4 \uac83\u00bb\uc774 \uc544\ub2c8\ub77c \u00ab\ub2e4\ub978 \ub208\uc774 \ud544\uc694\ud55c \uac83\u00bb(\ubc29\ud5a5 \ub4a4\uc9d1\ud798\u00b7\ub2e4\ub978 \uc601\uc5ed\u00b7\uc2a4\uc2a4\ub85c \uc138\uc6b0\uae30). \uacc4\uc0b0\ub9cc \ubb34\uac70\uc6b4 \uac83\uc740 SCENE2."}, {"id": "project2_worknote_scene1", "label": "SCENE1 \uae30\ubcf8\uc720\ud615", "file_type": "concept", "source_file": "project2/\uc791\uc5c5\ub178\ud2b8.md", "source_location": "\u00a70-A", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project2_worknote_scene2", "label": "SCENE2 \ubc1c\uc804\uc720\ud615", "file_type": "concept", "source_file": "project2/\uc791\uc5c5\ub178\ud2b8.md", "source_location": "\u00a70-A", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project2_worknote_scene3", "label": "SCENE3 \uc2e4\uc804", "file_type": "concept", "source_file": "project2/\uc791\uc5c5\ub178\ud2b8.md", "source_location": "\u00a70-A", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "project2_worknote_unit05_sets", "label": "05 \uc9d1\ud569 \u2014 470\u2192274\uc81c (v2, SCENE 46/159/69)", "file_type": "concept", "source_file": "project2/\uc791\uc5c5\ub178\ud2b8.md", "source_location": "\u00a70-C", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "23\uc720\ud615\uc744 \uc5ec\ub35f \ud68c\ucc28\ub85c \ub098\ub220 \uc804\uc218 \uc7ac\ud310\uc815. \uc61b \ud310\uc815 120\uc81c\ub294 \uacfc\uc555\ucd95. \ud2b9\ud788 \u300c\uc870\uac74\uc774 \ubd99\uc740 \ubd80\ubd84\uc9d1\ud569\u300d(\ud3d0\uc1c4\uc131 \uc14b), \u300c\uad50\uc9d1\ud569 \uc870\uac74\u300d, \u300c\ubc30\uc218\u00b7\uc57d\uc218\u300d(\ud3ec\ud568 \ubc29\ud5a5 \ubc18\ub300), \u300c\uc0c8 \uc5f0\uc0b0\u300d(\ub300\ubd80\ubd84 \ub300\uce6d\ucc28)\uc774 \ubb49\uac1c\uc838 \uc788\uc5c8\ub2e4. T21\u00b7T16\u00b7T09\u00b7T12\ub9cc \uc61b \ud310\uc815\uc774 \uc633\uc558\ub2e4."}, {"id": "project2_worknote_unit04_figure_transform", "label": "04 \ub3c4\ud615\uc758 \uc774\ub3d9 \u2014 234\u2192140\uc81c (v2, SCENE 23/67/50)", "file_type": "concept", "source_file": "project2/\uc791\uc5c5\ub178\ud2b8.md", "source_location": "\u00a70-B", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc791\uc5c5 \ud3f4\ub354 work2/, \ubd84\uc11d analysis2/. \uc61b \ud310\uc815\uc774 \u300cx\ucd95 \uc704 \uc810\uc744 \uac70\uccd0 \uac04\ub2e4\u300d\u300c\uc5f0\uc18d \uc774\ub3d9\u300d\u300c\uc811\ud55c\ub2e4\u300d\ub97c \ud558\ub098\ub85c \ubd24\uc73c\ub098 \uc2e4\uc81c \ucd95\uc774 \uac08\ub9b0\ub2e4. \ub300\uc0c1\uc774 \ub2ec\ub77c\ub3c4 \ubb3b\ub294 \uac83\uc774 \uac19\uc73c\uba74 \uc9c0\uc6b0\uace0, \ub300\uc0c1\uc774 \uac19\uc544\ub3c4 \ubb3b\ub294 \uac83\uc774 \ub2e4\ub974\uba74 \ub0a8\uae34\ub2e4. \uc0ac\uc6a9\uc790\uac00 \uc9da\uc740 \uc624\ud310 5\uac74(\uace0\uc7c1\uc774 237\u00b7238\u00b7254, \uc808\ub300\ub4f1\uae09 \uc9d1\uc911\uc5f0\uc2b52\u00b722)\uc740 \uc804\ubd80 \uc720\ud615 \ud0dc\uadf8\ub9cc \ubcf4\uace0 \uc9c0\uc6b4 \uac83."}, {"id": "project2_worknote_fixed_rules", "label": "\ud655\uc815\ub41c \uac83 \u2014 \uc6d0\ubb38 \uadf8\ub300\ub85c\u00b7\uac00\uc6b0\uc2a4 \uae30\ud638 \uae08\uc9c0\u00b7\ubaa8\uc758\uace0\uc0ac \uc81c\uc678\u00b7\ud589\ub82c\u00b7\ubcf5\uc18c\uc218 \uc0ac\uc6a9", "file_type": "rationale", "source_file": "project2/\uc791\uc5c5\ub178\ud2b8.md", "source_location": "\u00a71", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "\uc6d0\ubb38 \uc22b\uc790\u00b7\ud45c\ud604\uc744 \uc0c8\ub85c \uc4f0\uc9c0 \uc54a\ub294\ub2e4. \ubb38\uc81c\ubc88\ud638\ub294 \ube44\uc6b0\uace0 \u300c\ubb38\uc81c\u300d \uc790\ub9ac\ud45c\uc2dc\ub294 \uc9c0\uc6b4\ub2e4. \ucd9c\ucc98\ub294 1\ud589 2\uc5f4 \ubd89\uc740 \ud615\uad11 + \ubbf8\uc8fc\uc5d0 [\uc815\ub2f5]+\ud574\uc124. \ud589\ub82c\u00b7\ubcf5\uc18c\uc218\ub294 \uacf5\ud1b5\uc218\ud5591\uc774\ub77c \uc9d1\ud569\ubcf4\ub2e4 \uc55e\uc11c \ubc30\uc6b0\ubbc0\ub85c \uc18c\uc7ac\ub85c \uc4f4\ub2e4. \uac00\uc6b0\uc2a4 \uae30\ud638\ub294 \uace01 \ub0b4\uc2e0 \ubc94\uc704\uc5d0\uc11c \ube60\uc84c\ub2e4. \ubaa8\uc758\uace0\uc0ac \ubb38\ud56d\uc740 \ubcc4\ub3c4 \uad50\uc7ac\ub85c \ub0b8\ub2e4. \ubb38\ud56d\uc744 \ube7c\uac70\ub098 SCENE\uc744 \uc62e\uae30\uba74 \ud55c\uae00 \ubb38\ub2e8\ubc88\ud638\uac00 \uc804\ubd80 \ubc00\ub9b0\ub2e4."}, {"id": "project2_worknote_four_checks", "label": "\uac80\uc0ac 4\uc885 \u2014 \uace0\uce60 \ub54c\ub9c8\ub2e4 \ub2e4 \ub3cc\ub9b4 \uac83", "file_type": "concept", "source_file": "project2/\uc791\uc5c5\ub178\ud2b8.md", "source_location": "\u00a72", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "finalize2 \u2192 review-pool \u2192 build \u2192 audit \u2192 check-answers \u2192 zip \u2192 unzip verify \u2192 validate. \ub137\uc774 \ubcf4\ub294 \uac83\uc774 \uc11c\ub85c \ub2ec\ub77c \ud558\ub098\ub9cc \ubd10\uc11c\ub294 \u00ab\uc5f4\ub9ac\uc9c0\ub9cc \ub0b4\uc6a9\uc774 \ube48\u00bb \ud30c\uc77c\uc774 \ub098\uac04\ub2e4. \uac80\uc0ac\uae30\uac00 \u00ab\ub2e4\ub974\ub2e4\u00bb\uace0 \ud558\uba74 