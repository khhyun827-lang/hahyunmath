rules_version = '2';

// 김하현수학연구소 — Firestore 보안 규칙 (2026-09-07에 처음 파일로 남긴다)
//
// 🔴 **여태 규칙이 저장소에 없었다.** 콘솔에만 있어서 「지금 뭐로 돼 있나」를 아무도 몰랐고,
//   노트에 적힌 09-04 값을 믿고 이야기해야 했다. 이제 여기가 «적힌 곳»이다.
//   ⚠ **이 파일을 고쳐도 저절로 안 올라간다.** Firebase 콘솔 → Firestore → 규칙에
//     붙여넣고 «게시»해야 산다. 올린 뒤 이 머리말에 올린 날짜를 적을 것.
//
// ══ 왜 다시 쓰는가 ═══════════════════════════════════════════════════════
// 옛 규칙은 `allow read, write: if request.auth != null` 이었다. 그런데 앱이 맨 끝에서
// **모든 방문자**를 `signInAnonymously()` 로 인증시킨다. 그래서 그 조건은 «누구나»와 같은 말이었고,
// 사이트를 열기만 하면 학생 이름·전화번호·비밀번호가 통째로 내려갔다.
//
// 🔵 **고치는 열쇠는 «구분»이다** — 익명 인증은 우리 앱과 남을 구분하지 못한다.
//   그래서 학생·강사를 **Firebase Auth 진짜 계정**으로 만들고, 여기서 uid 로 가른다.
//
// ══ 누가 누구인가 ════════════════════════════════════════════════════════
//   강사·조교 → `teachers/{uid}` 문서가 **있으면** 강사다.
//     🔴 이 문서는 **콘솔에서 사람이 손으로** 만든다. 코드로 만들게 두면 아무나 강사가 된다.
//   학생     → `students/{uid}` — **문서 id 가 곧 Auth uid** 다.
//     🔵 학번이 아니라 uid 를 id 로 쓰는 까닭: 그래야 「내 문서인가」를 조회 없이 가른다.
//       학번은 문서 «안»에 `studentId` 로 그대로 남는다(화면 45곳이 그걸 쓴다).
//       ⚠ 2026-09-07에 테스트 학생을 다 지워서 **옮길 것이 없다.** 지금이 바꿀 때다.

// ⚠ **함수 이름은 반드시 영문이다.** 이 프로젝트는 무엇이든 한글로 이름 짓지만,
//   Firestore 규칙 언어는 한글 식별자를 못 받는다 — 2026-09-08에 게시하려다
//   「token recognition error at: '강'」 으로 한 글자씩 튕겨 나왔다.
//   주석은 한글 그대로 둔다. 막히는 것은 «이름»뿐이다.
//     signedIn() 로그인했나 · realAccount() 익명이 아닌 진짜 계정인가
//     isTeacher() 강사인가 · isMine(uid) 내 것인가

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    // 🔴 «익명이 아닌» 진짜 계정만 센다 — 익명은 아무나 받을 수 있다.
    function realAccount() {
      return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function isTeacher() {
      return realAccount()
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid));
    }
    function isMine(uid) {
      return realAccount() && request.auth.uid == uid;
    }

    // ── 누가 강사인가 ────────────────────────────────────────────────
    // 🔴 아무도 못 쓴다. 콘솔에서만 만든다 — 여기가 열리면 규칙 전체가 뜻을 잃는다.
    match /teachers/{uid} {
      allow read: if realAccount();
      allow write: if false;
    }

    // ── 학생 ─────────────────────────────────────────────────────────
    // 학생은 «자기 문서»만 읽는다. 명단 전체는 강사만.
    // 🔴 비밀번호(`pw`)는 이제 여기 없다 — Auth 가 해시로 들고 있다.
    match /students/{uid} {
      allow read: if isTeacher() || isMine(uid);
      allow write: if isTeacher();
    }

    // ── 연락처 — 학생 문서에서 갈라 낸다 ─────────────────────────────
    // 🔵 전화번호·학부모 전화번호는 **학생끼리도 보면 안 되는 것**이라 따로 둔다.
    //   갈라 두지 않으면 「명단을 보여 주려면 전화번호도 같이 내려간다」가 된다.
    match /contacts/{uid} {
      allow read, write: if isTeacher();
    }

    // ── 학생 기록 (출결·성적·과제·도장) ──────────────────────────────
    // ⚠ 예전에는 `kv/record:<학번>` 이었다. 컬렉션으로 뺀다 — kv 는 잡탕이라 규칙을 못 쓴다.
    match /records/{uid} {
      allow read, write: if isTeacher() || isMine(uid);
    }

    // ── 채팅 ─────────────────────────────────────────────────────────
    match /chats/{uid} {
      allow read, write: if isTeacher() || isMine(uid);
    }

    // ── 문항·교재 — 학생은 읽기만 ────────────────────────────────────
    match /items/{doc}       { allow read: if realAccount(); allow write: if isTeacher(); }
    match /variants/{doc}    { allow read: if realAccount(); allow write: if isTeacher(); }
    match /problembank/{doc} { allow read: if realAccount(); allow write: if isTeacher(); }
    match /exams/{doc}       { allow read: if realAccount(); allow write: if isTeacher(); }
    match /assignments/{doc} { allow read: if realAccount(); allow write: if isTeacher(); }
    match /classes/{doc}     { allow read: if realAccount(); allow write: if isTeacher(); }
    match /notices/{doc}     { allow read: if realAccount(); allow write: if isTeacher(); }
    match /videos/{doc}      { allow read: if realAccount(); allow write: if isTeacher(); }
    match /clinicslots/{doc} { allow read: if realAccount(); allow write: if isTeacher(); }
    /* 🔴 **2026-09-07에 빠져 있는 것을 찾았다.** 이 줄이 없으면 맨 아래 «전부 막는다»에 걸려
       조교가 로그인해도 아무것도 못 본다 — 제 계정조차 못 읽는다.
       ⚠ 새 컬렉션을 규칙에 적을 때는 **앱이 만지는 것을 하나씩 세어** 볼 것
         (`tools/rules-check.mjs` 가 그 목록을 들고 있다). */
    match /assistants/{doc} { allow read: if realAccount(); allow write: if isTeacher(); }

    // ── 학생이 «내는» 것 ─────────────────────────────────────────────
    // 🔵 낼 수는 있고, 남의 것은 못 본다. 처리는 강사가 한다.
    /* 🔵 아래 `resource.data.uid` 는 문서 «밖»에 따로 적힌 칸이다.
       이 앱은 내용을 `value` 한 칸에 JSON 글자로 넣는데, 규칙도 질의도 그 «안»은 못 본다.
       그래서 `dbSetDoc` 이 `data.uid` 를 밖에도 한 벌 적는다(index.html `docFields`).
       ⚠ 그 둘이 어긋날 수 없게 «언제나 data.uid 에서 뜬다» — 부르는 쪽이 따로 챙기지 않는다. */
    match /clinics/{doc} {
      allow read:   if isTeacher() || (realAccount() && resource.data.uid == request.auth.uid);
      allow create: if realAccount() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeacher();
    }
    match /qnas/{doc} {
      allow read:   if isTeacher() || (realAccount() && resource.data.uid == request.auth.uid);
      allow create: if realAccount() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isTeacher();
    }
    match /consults/{doc} {
      // ⚠ 상담 신청은 «로그인 전»에도 낸다(공개 홈의 문의). 그래서 익명도 만들 수 있다.
      //   대신 **아무도 못 읽는다** — 강사만 본다.
      allow read: if isTeacher();
      allow create: if signedIn();
      allow update, delete: if isTeacher();
    }

    // ── 변경 이력 — 강사만 ───────────────────────────────────────────
    // ⚠ 학생 행동도 여기 남는데, 남기는 것은 강사 화면에서 일어나는 일뿐이라 강사만으로 족하다.
    //   학생 쪽에서 남길 일이 생기면 그때 `create` 만 여는 것을 볼 것.
    match /auditlog/{doc} {
      allow read, write: if isTeacher();
    }

    // ── 게임 순위 ────────────────────────────────────────────────────
    /* 🔵 **순위표는 서로 본다 — 그게 의도다** (2026-09-08에 사용자가 확인했다).
       닫은 것은 «보는 것»이 아니라 **«남의 것을 쓰는 것»**이다.
       🔴 2026-09-08 전에는 `kv/rank:<월요일>` **문서 하나에 모두의 점수가 배열로** 있었다.
         학생이 제 점수를 올리려면 그 문서를 통째로 써야 했고,
         **한 학생이 남의 점수를 통째로 지울 수 있었다.** 규칙으로는 못 막는 모양이었다.
       🔵 그래서 «학생마다 한 문서»로 옮겼다 — `ranks/{주}__{uid}`.
         이제 «내 uid 가 박힌 문서»만 쓸 수 있다. 모양이 바뀌니 규칙이 일할 수 있게 됐다.
       ⚠ 지우기는 강사만 — 학생이 제 점수를 지우는 것도 순위를 흔드는 일이다. */
    match /ranks/{doc} {
      allow read: if realAccount();
      allow create, update: if realAccount() && request.resource.data.uid == request.auth.uid;
      allow delete: if isTeacher();
    }

    // ── 낱건 잡탕(kv) ────────────────────────────────────────────────
    // ⚠ kv 에는 설정(season·grade-cuts…)과 수업기록·상담일지가 섞여 산다.
    //   문서 이름으로 갈라야 곱게 쓸 수 있는데, 지금은 이렇게만 둔다:
    //   · 읽기 — 진짜 계정이면 (설정을 학생 화면이 본다)
    //   · 쓰기 — 강사만
    // 🔵 **2026-09-08에 `rank:` 예외를 걷어냈다** — 순위가 제 컬렉션으로 나갔기 때문이다.
    //   그 예외가 여기 남은 마지막 «학생 쓰기»였다. 이제 kv 는 강사만 쓴다.
    match /kv/{doc} {
      allow read: if realAccount();
      allow write: if isTeacher();
    }

    // ── 그 밖은 전부 막는다 ──────────────────────────────────────────
    // 🔵 여기가 있어야 «새로 생긴 컬렉션»이 조용히 열려 있지 않는다.
    //   새 컬렉션을 만들면 **여기서 403 이 난다** — 그때 위에 한 줄을 적으면 된다.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
